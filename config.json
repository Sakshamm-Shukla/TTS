{
  "run_name": "vits_run",
  "model": "vits",
  "batch_size": 8,
  "eval_batch_size": 4,
  "num_loader_workers": 2,
  "num_eval_loader_workers": 1,
  "run_eval": true,
  "test_delay_epochs": -1,
  "epochs": 1000,
  "text_cleaner": "phoneme_cleaners",
  "use_phonemes": true,
  "phoneme_language": "en-us",
  "phoneme_cache_path": "output/phoneme_cache",
  "print_step": 25,
  "print_eval": true,
  "mixed_precision": true,
  "output_path": "output",
  "datasets": [
    {
      "formatter": "ljspeech",
      "meta_file_train": "metadata.txt",
      "path": "MyTTSDataset"
    }
  ]
}
